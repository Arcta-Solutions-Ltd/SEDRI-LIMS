{
  "ConnectionStrings": {
    "arcConnection": "Server=localhost;User ID=postgres;Password=REPLACE_WITH_YOUR_POSTGRESQL_PASSWORD;Port=5432;Database=ArcLimsTest;Pooling=true;"
  },
  "QueueHash": {
    "ChainSeed": "ARC-QUEUE-CHAIN-SEED"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.Identity.Web": "Information"
    }
  },
  "NLog": {
    "autoReload": true,
    "throwConfigExceptions": true,
    "throwExceptions": false,
    "internalLogLevel": "Off",
    "extensions": [{ "assembly": "NLog.Web.AspNetCore" }],
    "variables": {
      "logDirectory": "${basedir}/logs"
    },
    "targets": {
      "appFileAsync": {
        "type": "AsyncWrapper",
        "overflowAction": "Discard",
        "queueLimit": 10000,
        "target": {
          "type": "File",
          "fileName": "${var:logDirectory}/arc-application.log",
          "layout": "${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}",
          "encoding": "utf-8",
          "keepFileOpen": true,
          "openFileCacheTimeout": 30,
          "concurrentWrites": true,
          "archiveFileName": "${var:logDirectory}/archive/arc-application-{#}.log",
          "archiveNumbering": "DateAndSequence",
          "archiveDateFormat": "yyyy-MM-dd",
          "archiveEvery": "Day",
          "archiveAboveSize": 5242880,
          "maxArchiveDays": 90,
          "maxArchiveFiles": 200
        }
      },
      "errorFileFallback": {
        "type": "FallbackGroup",
        "returnToFirstOnSuccess": true,
        "targets": {
          "file": {
            "type": "AsyncWrapper",
            "overflowAction": "Discard",
            "queueLimit": 10000,
            "target": {
              "type": "File",
              "fileName": "${var:logDirectory}/arc-errors.log",
              "layout": "${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-method} ${aspnet-request-url}|${message}${onexception:${newline}${exception:format=tostring}}",
              "encoding": "utf-8",
              "keepFileOpen": true,
              "openFileCacheTimeout": 30,
              "concurrentWrites": true,
              "archiveFileName": "${var:logDirectory}/archive/arc-errors-{#}.log",
              "archiveNumbering": "DateAndSequence",
              "archiveDateFormat": "yyyy-MM-dd",
              "archiveEvery": "Day",
              "archiveAboveSize": 5242880,
              "maxArchiveDays": 90,
              "maxArchiveFiles": 100
            }
          },
          "console": {
            "type": "Console",
            "layout": "${MicrosoftConsoleLayout}"
          }
        }
      },
      "console": {
        "type": "Console",
        "layout": "${MicrosoftConsoleLayout}"
      }
    },
    "rules": [
      { "logger": "*", "minLevel": "Trace", "writeTo": "appFileAsync" },
      { "logger": "*", "minLevel": "Warn", "writeTo": "errorFileFallback,console" },
      {
        "logger": "Microsoft.Hosting.Lifetime",
        "minLevel": "Info",
        "writeTo": "console"
      }
    ]
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Local": {
      "Name": "Local",
      "Enabled": true,
      "Key": "REPLACE_WITH_YOUR_OWN_LONG_RANDOM_SECRET",
      "Issuer": "http://test.co.uk",
      "Audience": "http://test.co.uk"
    },
    "AzureAd": {
      "Name": "AzureAd",
      "Enabled": false,
      "Instance": "https://login.microsoftonline.com/",
      "Domain": "yourcompany.example",
      "TenantId": "00000000-0000-0000-0000-000000000000",
      "ClientId": "00000000-0000-0000-0000-000000000000",
      "Audience": "api://00000000-0000-0000-0000-000000000000"
    }
  },
  "Urls": {
    "webclient": "http://localhost:3000"
  },
  "Files": {
    "UseCloudStorage": false,
    "BlobServiceUri": "https://yourstorageaccount.blob.core.windows.net",
    "ContainerName": "local-development",
    "ConnectionString": "",
    "StorageRoot": "C:\\arc-storage",
    "AllowedContentTypes": [
      "image/png",
      "image/jpeg",
      "application/pdf",
      ".png",
      ".jpg",
      ".jpeg",
      ".pdf",
      ".xml",
      ".json",
      "application/json",
      ".js",
      ".txt"
    ],
    "BlockedExtensions": [
      ".exe",
      ".msi",
      ".bat",
      ".cmd",
      ".ps1",
      ".sh",
      ".dll",
      ".com",
      ".scr"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:5001"
      }
    }
  },
  "IsEvaluationSystem": false,
  "SecurityHeaders": {
    "XFrameOptions": "SAMEORIGIN",
    "XContentTypeOptions": "nosniff",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "PermissionsPolicy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()",
    "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'; base-uri 'none'"
  }
}
